{
  "name": "lume",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @lume/storefront test:e2e",
    "dev:web": "pnpm --filter @lume/storefront dev",
    "dev:api": "pnpm --filter @lume/commerce dev",
    "db:push": "pnpm --filter @lume/commerce db:push",
    "db:seed": "pnpm --filter @lume/commerce db:seed"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
