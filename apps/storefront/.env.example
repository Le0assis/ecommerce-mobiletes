# URL pública do site. Usada em metadados, Open Graph e sitemap.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# A API de commerce vista pelo servidor Next (rewrite de /api/commerce).
# Não use NEXT_PUBLIC aqui: o browser fala com o próprio site.
COMMERCE_API_URL=http://127.0.0.1:8787

# WhatsApp no formato internacional, sem + e sem espaços. O botão abre wa.me.
NEXT_PUBLIC_WHATSAPP=551140001900

# Medição local. Só o valor console escreve evento no navegador, e só depois do aviso "Permitir medição local".
# Vazio desliga. Não coloque script de terceiro aqui.
NEXT_PUBLIC_ANALYTICS=
