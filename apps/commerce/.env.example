PORT=8787
# Postgres do docker compose (porta do host 54329).
DATABASE_URL=postgres://lume:lume@127.0.0.1:54329/lume
# Opcional. Sem Redis o carrinho e o rate limit ficam em memória.
REDIS_URL=redis://127.0.0.1:63799
# Opcional. Sem Meilisearch a busca usa o catálogo em memória.
# lume-dev-master-key é exemplo só local, nunca em produção. Tem de ser a mesma do docker-compose.yml.
MEILI_HOST=http://127.0.0.1:7709
MEILI_MASTER_KEY=lume-dev-master-key
# Hash scrypt da senha única de admin. Não cole a senha aqui.
# Gere com hashAdminPassword em src/auth.ts: scrypt$<sal hex>$<hash hex>
ADMIN_PASSWORD_HASH=
# Token de escrita do Vercel Blob. Fica só no servidor. Sem ele, POST /v1/admin/uploads responde 503.
BLOB_READ_WRITE_TOKEN=
# Obrigatório. 32 caracteres ou mais, 16 distintos, entropia Shannon de pelo menos 3 bits por caractere.
# Um caractere repetido não sobe. Fora de produção o cabeçalho x-admin-token usa este valor. Em produção o cabeçalho não autentica.
# ADMIN_TOKEN=
# Substitui STOREFRONT_ORIGIN. Origens do browser que chamam a API direto, com esquema e sem caminho.
# Sem esta lista o CORS fica fechado em qualquer NODE_ENV. A vitrine no mesmo host usa /api/commerce.
CORS_ORIGINS=http://127.0.0.1:43123
# Avanço de rastreio em POST /v1/orders/:ref/sandbox. Ausente ou diferente de 1/true deixa a rota em 404.
# LUME_ENABLE_SANDBOX=1
# Código de login LUME-SANDBOX. Ausente, o código não entra em nenhum NODE_ENV.
# LUME_SANDBOX=1
# Única forma de subir em memória se o Postgres ou a migração falhar. Ausente, o processo encerra.
# LUME_ALLOW_MEMORY_FALLBACK=1
# IPs de proxy que podem definir o cliente. Sem isso, o limite usa o socket e ignora x-forwarded-for.
# Na Vercel a plataforma define VERCEL=1 e a API lê x-vercel-forwarded-for.
TRUSTED_PROXIES=
