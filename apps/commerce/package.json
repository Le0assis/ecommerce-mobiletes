  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "^22",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3"
